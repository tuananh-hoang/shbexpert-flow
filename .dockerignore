# Build context for api/worker/mcp-*/tools-mock is the repo root (so they
# can COPY shared/) — keep the context small so `docker build` doesn't ship
# unrelated large files (reference PDFs, docs, node_modules) to the daemon.
.git
.gitignore
*.md
*.pdf
*.docx
docs/
web/node_modules/
web/.next/
**/__pycache__/
**/*.pyc
.venv/
venv/
.env
.env.*
!.env.example
