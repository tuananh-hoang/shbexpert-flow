# Copy to .env and fill in before `docker compose up`.
# Không commit .env thật — .gitignore đã chặn *.env* (trừ .env.example).

# --- Postgres (CaseState + event log + LangGraph checkpoint) ---
# shbuser = superuser, dùng CHỈ cho Alembic (DDL). shbapp = least-privilege
# role api/worker dùng ở runtime — bắt buộc phải khác nhau, vì REVOKE
# UPDATE/DELETE trên `events` (append-only) là no-op nếu app kết nối bằng
# superuser (postgres.md/init/01-init-app-role.sh + migration 0002).
POSTGRES_USER=shbuser
POSTGRES_PASSWORD=shbpass
POSTGRES_DB=shbexpert
SHBAPP_USER=shbapp
SHBAPP_PASSWORD=shbapppass

DATABASE_URL=postgresql+psycopg2://shbapp:shbapppass@postgres:5432/shbexpert
ADMIN_DATABASE_URL=postgresql+psycopg2://shbuser:shbpass@postgres:5432/shbexpert

# --- Redis (job queue api -> worker, ephemeral) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (document + credit memo object store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
# Dùng để KÝ presigned URL cho evidence drawer (trình duyệt) — khác
# MINIO_ENDPOINT (dùng cho api/worker gọi nội bộ qua Docker network).
# Đổi thành domain thật khi deploy lên VM.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=shbexpert-documents

# --- Qdrant (policy / legal / industry knowledge, accessed only via mcp-rag) ---
QDRANT_URL=http://qdrant:6333

# --- LLM provider (theo tier, xem worker/config/models.yaml) ---
# LLM_MOCK=true chạy toàn luồng bằng kết quả deterministic theo seed,
# không cần key nào — dùng khi chưa có ANTHROPIC_API_KEY/OPENAI_API_KEY.
LLM_MOCK=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- MCP servers (internal URLs — không publish port ra host) ---
MCP_DETERMINISTIC_URL=http://mcp-deterministic:8200/mcp
MCP_RAG_URL=http://mcp-rag:8201/mcp
MCP_EXTERNAL_URL=http://mcp-external:8202/mcp
MCP_STATE_URL=http://mcp-state:8203/mcp

# --- tools-mock (CIC / KYC / AML / valuation / LOS mock, bọc bởi mcp-external) ---
TOOLS_MOCK_URL=http://tools-mock:8100

# --- api (internal URL, dùng bởi mcp-state và web's Next.js rewrite) ---
API_INTERNAL_URL=http://api:8000

# --- worker's Chat Orchestrator internal HTTP surface (ai-architecture_v2.md
# §11.8) — không publish port ra host, chỉ api gọi tới ---
WORKER_INTERNAL_URL=http://worker:8300

# --- Demo fallback (PRD 14.4) ---
DEMO_REPLAY=false

# --- synthetic_data_pipeline/narrative.py (FPT AI Marketplace) ---
FPT_API_KEY=replace-with-your-key
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_MODEL=Llama-3.3-70B-Instruct
FPT_TIMEOUT_SECONDS=60
FPT_MAX_OUTPUT_TOKENS=600
